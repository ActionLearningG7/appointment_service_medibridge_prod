# Appointment Service - Test Environment Configuration
# DO NOT commit sensitive values to Git
# Last Updated: 2026-05-09

# Server Configuration
SERVER_PORT=8083
SPRING_PROFILE=test

# Database Configuration
DB_HOST=test-db-server
DB_PORT=3306
DB_NAME=medibridge_appointments_test
DB_USER=test_user
DB_PASSWORD=test_password

# Redis Configuration
REDIS_URL=redis://test-redis:6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka-test:9092

# Eureka Configuration
EUREKA_PROTOCOL=http
EUREKA_HOST=eureka-test
EUREKA_PORT=8761
EUREKA_PREFER_IP_ADDRESS=false

# JWT Configuration
JWT_SECRET=MediBridge2026!Test$ecretK3y#Tes7Env@Secur1ty
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# Logging Configuration
LOG_LEVEL=INFO
LOG_LEVEL_MEDIBRIDGE=DEBUG
LOG_FILE_PATH=

# Mail Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test@mailtrap.io
SMTP_PASSWORD=test_password
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=test@medibridge.local

# JPA Configuration
DDL_AUTO=create-drop
SHOW_SQL=false

# Management
MANAGEMENT_ENDPOINTS_EXPOSURE=health,info,metrics
HEALTH_SHOW_DETAILS=when-authorized
