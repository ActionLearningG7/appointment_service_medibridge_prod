# Appointment Service - Production Environment Configuration
# ***SENSITIVE FILE - DO NOT COMMIT TO GIT***
# Add to .gitignore: .env.prod
# Permissions: chmod 600 .env.prod
# Last Updated: 2026-05-09

# Server Configuration
SERVER_PORT=8083
SPRING_PROFILE=prod

# Database Configuration - CONFIGURE BEFORE DEPLOYMENT
DB_HOST=prod-db
DB_PORT=3306
DB_NAME=medibridge_appointments_prod
DB_USER=produser
DB_PASSWORD=***CONFIGURE_ME***

# Redis Configuration
REDIS_URL=redis://prod-redis:6379
REDIS_PASSWORD=***CONFIGURE_ME***

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka-prod:9092

# Eureka Configuration
EUREKA_PROTOCOL=https
EUREKA_HOST=eureka-prod
EUREKA_PORT=443
EUREKA_PREFER_IP_ADDRESS=true

# JWT Configuration - CONFIGURE BEFORE DEPLOYMENT
JWT_SECRET=***CONFIGURE_ME***
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Logging Configuration
LOG_LEVEL=WARN
LOG_LEVEL_MEDIBRIDGE=INFO
LOG_FILE_PATH=/var/log/medibridge/appointment-service.log

# Mail Configuration - CONFIGURE BEFORE DEPLOYMENT
SMTP_HOST=mail-prod.internal
SMTP_PORT=25
SMTP_USER=***CONFIGURE_ME***
SMTP_PASSWORD=***CONFIGURE_ME***
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=noreply@medibridge.com

# JPA Configuration
DDL_AUTO=validate
SHOW_SQL=false

# Management
MANAGEMENT_ENDPOINTS_EXPOSURE=health,info,metrics
HEALTH_SHOW_DETAILS=when-authorized
